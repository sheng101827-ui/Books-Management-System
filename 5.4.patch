+    public boolean renewBook(long sernum){
+        Lend lend = lendDao.getLendBySernum(sernum);
+        Date backDate = lend.getBackDate();
+        if (backDate == null) {
+            return false;
+        }
+        long thirtyDaysMillis = 30L * 24 * 60 * 60 * 1000;
+        Date newBackDate = new Date(backDate.getTime() + thirtyDaysMillis);
+        SimpleDateFormat df = new SimpleDateFormat("yyyy-MM-dd");
+        return lendDao.renewBook(sernum, df.format(newBackDate)) > 0;
+    }
