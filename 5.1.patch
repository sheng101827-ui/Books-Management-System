diff --git a/src/main/java/com/book/dao/LendDao.java b/src/main/java/com/book/dao/LendDao.java
index f706a87..fb58d3c 100644
--- a/src/main/java/com/book/dao/LendDao.java
+++ b/src/main/java/com/book/dao/LendDao.java
@@ -35,6 +35,30 @@ public class LendDao {
 
     private final static String MY_LEND_LIST_SQL="SELECT * FROM lend_list WHERE reader_id = ? ";
 
+    private final static String RENEW_BOOK_SQL="UPDATE lend_list SET back_date = ? WHERE sernum = ? ";
+
+    private final static String GET_LEND_BY_SERNUM_SQL="SELECT * FROM lend_list WHERE sernum = ? ";
+
+    public int renewBook(long sernum, String backDate){
+        return jdbcTemplate.update(RENEW_BOOK_SQL,new Object[]{backDate,sernum});
+    }
+
+    public Lend getLendBySernum(long sernum){
+        final Lend lend = new Lend();
+        jdbcTemplate.query(GET_LEND_BY_SERNUM_SQL, new Object[]{sernum}, new RowCallbackHandler() {
+            public void processRow(ResultSet resultSet) throws SQLException {
+                if (resultSet.next()){
+                    lend.setBackDate(resultSet.getDate("back_date"));
+                    lend.setBookId(resultSet.getLong("book_id"));
+                    lend.setLendDate(resultSet.getDate("lend_date"));
+                    lend.setReaderId(resultSet.getInt("reader_id"));
+                    lend.setSernum(resultSet.getLong("sernum"));
+                }
+            }
+        });
+        return lend;
+    }
+
     public int bookReturnOne(long bookId){
         return  jdbcTemplate.update(BOOK_RETURN_SQL_ONE,new Object[]{df.format(new Date()),bookId});
     }
