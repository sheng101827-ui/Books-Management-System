diff --git a/src/main/java/com/book/dao/ReaderCardDao.java b/src/main/java/com/book/dao/ReaderCardDao.java
index 0c39f9f..2b90b30 100644
--- a/src/main/java/com/book/dao/ReaderCardDao.java
+++ b/src/main/java/com/book/dao/ReaderCardDao.java
@@ -21,6 +21,7 @@ public class ReaderCardDao {
     private final static String RE_PASSWORD_SQL="UPDATE reader_card set passwd = ? where reader_id = ? ";
     private final static String ADD_READERCARD_SQL="INSERT INTO reader_card (reader_id,name) values ( ? , ?)";
     private final static String UPDATE_READER_NAME_SQL="UPDATE reader_card set name = ? where reader_id = ?";
+    private final static String LOSS_CARD_SQL="UPDATE reader_card set card_state = 0 where reader_id = ?";
 
 
     @Autowired
@@ -62,4 +63,8 @@ public class ReaderCardDao {
     public int updateName(int readerId,String name){
         return jdbcTemplate.update(UPDATE_READER_NAME_SQL,new Object[]{name,readerId,});
     }
+
+    public int lossCard(int readerId){
+        return jdbcTemplate.update(LOSS_CARD_SQL,new Object[]{readerId});
+    }
 }
diff --git a/src/main/java/com/book/service/ReaderCardService.java b/src/main/java/com/book/service/ReaderCardService.java
index 073e91d..58153fb 100644
--- a/src/main/java/com/book/service/ReaderCardService.java
+++ b/src/main/java/com/book/service/ReaderCardService.java
@@ -23,4 +23,11 @@ public class ReaderCardService {
         return readerCardDao.updateName(readerId,name)>0;
     }
 
+    public void lossCard(int readerId){
+        com.book.domain.ReaderCard readerCard = readerCardDao.findReaderByReaderId(readerId);
+        if (readerCard.getReaderId() == 0) {
+            throw new RuntimeException("读者不存在，无法挂失读者卡！");
+        }
+        readerCardDao.lossCard(readerId);
+    }
 }
